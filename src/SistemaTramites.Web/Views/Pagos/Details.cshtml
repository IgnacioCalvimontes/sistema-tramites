@model Pago

@{
    ViewData["Title"] = "Detalle";
}

<h1>Detalle</h1>
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Tramite)</dt>
        <dd class="col-sm-9">@(Model.Tramite != null ? Model.Tramite!.CodigoSeguimiento : "-")</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Cajero)</dt>
        <dd class="col-sm-9">@(Model.Cajero != null ? Model.Cajero!.Nombre : "-")</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Monto)</dt>
        <dd class="col-sm-9">@Model.Monto.ToString("N2")</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NumeroRecibo)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.NumeroRecibo)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaPago)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.FechaPago)</dd>
        
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
