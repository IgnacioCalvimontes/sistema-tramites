<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Trámites Ciudadanos</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="seal">N19</span>
                    <span>Notaría N° 19 — Trámites</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Operaciones" asp-action="RegistrarSolicitud">Registrar solicitud</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Operaciones" asp-action="RegistrarPago">Registrar pago</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Tramites" asp-action="Index">Trámites</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Citas" asp-action="Index">Citas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Documentos" asp-action="Index">Documentos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Pagos" asp-action="Index">Pagos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Protocolos" asp-action="Index">Protocolo</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Notificaciones" asp-action="Index">Notificaciones</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Catálogos</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Ciudadanos" asp-action="Index">Ciudadanos</a></li>
                                <li><a class="dropdown-item" asp-controller="TiposTramite" asp-action="Index">Tipos de trámite</a></li>
                                <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">Usuarios (roles)</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item d-flex align-items-center text-light me-3">
                        <span>👤 @User.Identity!.Name</span>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-outline-light btn-sm">Salir</button>
                        </form>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container mt-4">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Mensaje"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted mt-5 py-3">
        <div class="container">
            Sistema de Información de Trámites Ciudadanos — Notaría de Fe Pública N° 19 de Sucre, Bolivia
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
