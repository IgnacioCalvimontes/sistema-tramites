@{
    ViewData["Title"] = "Registrar pago";
}

<h1>Registrar pago y emitir recibo</h1>
<p class="text-muted">Ciudadano → Caja → Sistema: registra el pago, actualiza el estado del trámite, emite el recibo y envía la notificación (RF-05, RF-09).</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="RegistrarPago" method="post" class="col-md-6">
    <div class="mb-3">
        <label class="form-label">Trámite pendiente de pago</label>
        <select name="tramiteId" class="form-select" asp-items="ViewBag.TramiteId" required>
            <option value="">-- Seleccione --</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Cajero que registra el pago</label>
        <select name="cajeroId" class="form-select" asp-items="ViewBag.CajeroId" required>
            <option value="">-- Seleccione --</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Monto recibido (Bs)</label>
        <input name="monto" type="number" step="0.01" min="0.01" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-success">Registrar pago</button>
</form>
