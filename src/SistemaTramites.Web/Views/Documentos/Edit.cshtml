@model DocumentoAdjunto

@{
    ViewData["Title"] = "Editar — Documentos adjuntos";
}

<h1>Editar registro</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
                <label asp-for="TramiteId" class="form-label"></label>
                <select asp-for="TramiteId" class="form-select" asp-items="ViewBag.TramiteId">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="TramiteId" class="text-danger"></span>
            </div>
    <div class="mb-3">
                <label asp-for="TipoDocumento" class="form-label"></label>
                <input asp-for="TipoDocumento" class="form-control" />
                <span asp-validation-for="TipoDocumento" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ArchivoRuta" class="form-label"></label>
                <input asp-for="ArchivoRuta" class="form-control" />
                <span asp-validation-for="ArchivoRuta" class="text-danger"></span>
            </div>
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
