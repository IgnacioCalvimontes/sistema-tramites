@model IEnumerable<Tramite>

@{
    ViewData["Title"] = "Trámites";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Trámites</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Ciudadano)</th>
            <th>@Html.DisplayNameFor(model => model.TipoTramite)</th>
            <th>@Html.DisplayNameFor(model => model.Oficial)</th>
            <th>@Html.DisplayNameFor(model => model.CodigoSeguimiento)</th>
            <th>@Html.DisplayNameFor(model => model.FechaSolicitud)</th>
            <th>@Html.DisplayNameFor(model => model.Estado)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@(item.Ciudadano != null ? item.Ciudadano!.Nombre : "-")</td>
                <td>@(item.TipoTramite != null ? item.TipoTramite!.Nombre : "-")</td>
                <td>@(item.Oficial != null ? item.Oficial!.Nombre : "-")</td>
                <td>@Html.DisplayFor(modelItem => item.CodigoSeguimiento)</td>
                <td>@Html.DisplayFor(modelItem => item.FechaSolicitud)</td>
                <td><span class="badge-estado @item.Estado.ToLower().Replace(" ", "-")">@item.Estado</span></td>
                <td class="text-end">
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
