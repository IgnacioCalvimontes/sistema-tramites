@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutLogin";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card" style="width: 430px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <span class="seal d-inline-flex mb-3" style="width:44px;height:44px;font-size:0.9rem;">N19</span>
                <h1 class="h4 mb-1">Sistema de Trámites Ciudadanos</h1>
                <p class="text-muted mb-0" style="font-size:0.9rem;">Notaría de Fe Pública N° 19 — Sucre</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <form asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="UsuarioLogin" class="form-label"></label>
                    <input asp-for="UsuarioLogin" class="form-control" autofocus autocomplete="username" />
                    <span asp-validation-for="UsuarioLogin" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Recordarme" class="form-check-input" />
                    <label asp-for="Recordarme" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-primary w-100">Ingresar</button>
            </form>

            <div class="text-center mt-3">
                <a asp-controller="Seguimiento" asp-action="Index" class="small">
                    Consultar un trámite con mi código de seguimiento
                </a>
            </div>

            <hr style="border-color: var(--line);" />
            <p class="small text-muted mb-2">
                Cuentas de prueba — contraseña <code>Notaria2026</code>:
            </p>
            <div class="small text-muted">
                <div class="fw-semibold mb-1" style="color: var(--ink-soft);">Personal de la notaría</div>
                <ul class="mb-2 ps-3">
                    <li><code>admin</code> — Administrador (acceso completo)</li>
                    <li><code>amontes</code> — Notario (roles, reportes, protocolo)</li>
                    <li><code>mrojas</code> — Ventanilla (solicitudes y citas)</li>
                    <li><code>lparedes</code> — Caja (pagos y recibos)</li>
                    <li><code>cfernandez</code> — Oficial (expedientes)</li>
                    <li><code>jsalazar</code> — Archivo (protocolización)</li>
                </ul>
                <div class="fw-semibold mb-1" style="color: var(--ink-soft);">Ciudadanos</div>
                <ul class="mb-0 ps-3">
                    <li><code>bchoque</code> — Beatriz Choque</li>
                    <li><code>rquispe</code> — Ramiro Quispe</li>
                </ul>
            </div>
        </div>
    </div>
</div>
