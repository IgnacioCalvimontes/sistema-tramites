@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutLogin";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card" style="width: 400px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <span class="seal d-inline-flex mb-3" style="width:44px;height:44px;font-size:0.9rem;">N19</span>
                <h1 class="h4 mb-1">Sistema de Trámites Ciudadanos</h1>
                <p class="text-muted mb-0" style="font-size:0.9rem;">Notaría de Fe Pública N° 19 — Sucre</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <form asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="UsuarioLogin" class="form-label"></label>
                    <input asp-for="UsuarioLogin" class="form-control" autofocus />
                    <span asp-validation-for="UsuarioLogin" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Recordarme" class="form-check-input" />
                    <label asp-for="Recordarme" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-primary w-100">Ingresar</button>
            </form>

            <hr style="border-color: var(--line);" />
            <p class="small text-muted mb-1">Cuentas de prueba (contraseña <code>Notaria2026</code>):</p>
            <ul class="small text-muted mb-0 ps-3">
                <li><code>admin</code> — Administrador</li>
                <li><code>amontes</code> — Notario</li>
                <li><code>mrojas</code> — Ventanilla</li>
                <li><code>lparedes</code> — Caja</li>
                <li><code>cfernandez</code> — Oficial</li>
                <li><code>jsalazar</code> — Archivo</li>
            </ul>
        </div>
    </div>
</div>
